{
  "name": "@ehpeek/reader",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/ReadingView.d.ts",
      "default": "./dist/ReadingView.js"
    },
    "./interfaces": {
      "types": "./dist/kit/interfaces.d.ts",
      "default": "./dist/kit/interfaces.js"
    },
    "./kit/Widgets": {
      "types": "./dist/kit/Widgets/index.d.ts",
      "default": "./dist/kit/Widgets/index.js"
    },
    "./kit/*": {
      "types": "./dist/kit/*.d.ts",
      "default": "./dist/kit/*.js"
    }
  },
  "peerDependencies": {
    "solid-js": "^1.9.14"
  },
  "dependencies": {
    "lucide-solid": "^1.26.0"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json",
    "check": "tsc --noEmit && pnpm check:consumer",
    "build:example": "node example.mjs",
    "example": "pnpm build && node example.mjs --serve",
    "check:consumer": "tsc --noEmit --strict --noUncheckedIndexedAccess --target ES2020 --module ESNext --moduleResolution Bundler --jsx preserve --jsxImportSource solid-js tests/consumer.tsx examples/basic/main.tsx"
  },
  "files": [
    "dist"
  ]
}
