{
  "compilerOptions": {
    "target": "ES2020",
    "paths": {
      "@ehpeek/reader": ["./packages/reader/src/index.ts"],
      "@ehpeek/reader/*": ["./packages/reader/src/*"]
    },
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["packages/*/src", "packages/*/examples"]
}
